{
  "name": "mcp-httpserver-proxy",
  "version": "1.0.0",
  "description": "Proxy to bind a local MCP server listening over HTTP/SSE to Claude Desktop via stdio",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "check": "trunk check",
    "check:ci": "trunk check --ci",
    "format": "trunk fmt",
    "prepare": "if [ -z \"$CI\" ]; then git config --unset core.hooksPath || true && trunk git-hooks sync; else echo 'Skipping Git hooks in CI'; fi"
  },
  "keywords": [
    "mcp",
    "claude",
    "proxy",
    "sse",
    "stdio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3"
  }
}
