{
  "name": "mcp-httpserver-proxy",
  "version": "1.0.0",
  "description": "Transparent proxy bridging HTTP/SSE Model Context Protocol (MCP) servers to stdio-based clients like Claude Desktop and Cursor",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-httpserver-proxy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "check": "trunk check",
    "check:ci": "trunk check --ci",
    "format": "trunk fmt",
    "prepare": "if [ -z \"$CI\" ]; then git config --unset core.hooksPath || true && trunk git-hooks sync; else echo 'Skipping Git hooks in CI'; fi"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "cursor",
    "proxy",
    "sse",
    "stdio",
    "json-rpc",
    "ai-tools"
  ],
  "author": "shailesh17",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shailesh17/mcp-httpserver-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/shailesh17/mcp-httpserver-proxy/issues"
  },
  "homepage": "https://github.com/shailesh17/mcp-httpserver-proxy#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
